<Project>

  <!--
    The suite's dependency rules, enforced by the build rather than documented.

    Etymon's whole pitch rests on a package graph a consumer can reason about:
    Core takes nothing but FSharp.Core, every package takes at most one external
    runtime dependency, and no package references a sibling it does not strictly
    need. Those are the kind of rules that hold for a year and then quietly stop
    holding, because the reference that breaks them is always individually
    reasonable. So they are build errors.

    Each shipping project declares what it is allowed to reference:

      <EtymonAllowedReferences>Etymon.Core;Etymon.Schema</EtymonAllowedReferences>

    An empty value means "nothing", which is what Etymon.Core declares. Set
    EtymonEnforceLayers=false to get a build out of a broken tree while working.
  -->

  <PropertyGroup>
    <EtymonEnforceLayers Condition="'$(EtymonEnforceLayers)' == ''">true</EtymonEnforceLayers>
  </PropertyGroup>

  <!--
    Snapshotted here, at import time, rather than read inside the target.
    Directory.Build.targets is imported at the very end of the project file, so at
    this point @(ProjectReference) is exactly what the project declared. By the
    time a target runs, the SDK has added every transitive project reference too,
    and the rule would fail a project for something it never asked for.
  -->
  <ItemGroup>
    <EtymonDeclaredReference Include="@(ProjectReference->'%(Filename)')" />
  </ItemGroup>

  <ItemGroup>
    <!-- Packages that exist to test Etymon, and must never reach a consumer. -->
    <EtymonTestOnlyPackage Include="Expecto" />
    <EtymonTestOnlyPackage Include="Expecto.FsCheck" />
    <EtymonTestOnlyPackage Include="Npgsql" />
    <EtymonTestOnlyPackage Include="Microsoft.Data.Sqlite" />
    <EtymonTestOnlyPackage Include="Testcontainers.PostgreSql" />
    <EtymonTestOnlyPackage Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <Target Name="EtymonEnforceDependencyRules"
          BeforeTargets="Build;Pack"
          Condition="'$(EtymonEnforceLayers)' == 'true' AND '$(IsPackable)' == 'true'">

    <!-- Exclude is exact-identity set subtraction, which is the one reliable way to
         intersect two item lists in MSBuild. A ~= B minus (B minus A). -->
    <ItemGroup>
      <_EtymonReferenced Include="@(EtymonDeclaredReference)" />
      <_EtymonAllowed Include="$(EtymonAllowedReferences)" />
      <_EtymonForbiddenProject Include="@(_EtymonReferenced)" Exclude="@(_EtymonAllowed)" />

      <_EtymonPermittedPackage Include="@(PackageReference)" Exclude="@(EtymonTestOnlyPackage)" />
      <_EtymonLeakedTestPackage Include="@(PackageReference)" Exclude="@(_EtymonPermittedPackage)" />
    </ItemGroup>

    <!-- A shipping package must say what it may reference, even if the answer is nothing. -->
    <Error Condition="'$(EtymonAllowedReferences)' == '' AND '@(EtymonDeclaredReference)' != ''"
           Code="ETY0001"
           Text="$(MSBuildProjectName) references other projects but declares no &lt;EtymonAllowedReferences&gt;. Add the property to $(MSBuildProjectFile), listing the siblings it strictly needs." />

    <Error Condition="'@(_EtymonForbiddenProject)' != ''"
           Code="ETY0002"
           Text="$(MSBuildProjectName) references @(_EtymonForbiddenProject, ', '), which is not in its declared &lt;EtymonAllowedReferences&gt; ('$(EtymonAllowedReferences)'). Either the reference is wrong, or the rule has changed and the declaration should say so." />

    <Error Condition="'@(_EtymonLeakedTestPackage)' != ''"
           Code="ETY0003"
           Text="$(MSBuildProjectName) is a shipping package but references @(_EtymonLeakedTestPackage, ', '), which is test-only. A consumer would inherit it." />

  </Target>

  <!--
    The public surface of every shipping package, as a signature file the
    compiler writes on every build.

    .NET XML documentation has nowhere to put a return type. The generated member
    names carry parameter types and nothing else, so a reader working from the
    package on disk — the .xml and the .dll, which is all an adopter sees —
    learns what a function hands back by compiling something and reading the
    error. Surface.fsi is the answer: every public value with its full signature
    and its documentation, one file per package, shipped at the root of the
    nupkg next to README.md.

    Generated rather than written. A hand-written signature file is a contract
    the compiler enforces, which is a real benefit with a real cost: fifteen
    packages of signatures kept in step with the code, and a surface that is
    frozen until somebody edits two files. This one is a record the compiler
    produces from the implementation, so it cannot drift; and it is committed,
    so a change to the public surface shows up as a diff in review — which is
    the benefit a signature file exists to give, without the upkeep. CI fails
    when the committed copy is stale.

    Both target frameworks produce the same surface (checked when this was
    added), so it is written from one of them.
  -->
  <PropertyGroup>
    <EtymonSurfaceFramework Condition="'$(EtymonSurfaceFramework)' == ''">net10.0</EtymonSurfaceFramework>
    <_EtymonWritesSurface Condition="'$(IsPackable)' == 'true' AND '$(IncludeBuildOutput)' != 'false'">true</_EtymonWritesSurface>
  </PropertyGroup>

  <!-- A silent stop is the one failure this must not have. If the surface
       framework is ever dropped from TargetFrameworks, nothing would write the
       file, the committed copy would go stale, and the content check in CI
       would pass on stale content forever. So the mismatch is a build error,
       like the dependency rules above. -->
  <Target Name="EtymonSurfaceFrameworkIsBuilt"
          BeforeTargets="Build"
          Condition="'$(_EtymonWritesSurface)' == 'true' AND '$(TargetFrameworks)' != '' AND !$([System.String]::Concat(';', '$(TargetFrameworks)', ';').Contains(';$(EtymonSurfaceFramework);'))">
    <Error Code="ETY0004"
           Text="$(MSBuildProjectName) targets '$(TargetFrameworks)', which does not include EtymonSurfaceFramework '$(EtymonSurfaceFramework)'. Surface.fsi would never be written again and the committed copy would go stale without anything noticing. Point EtymonSurfaceFramework in Directory.Build.targets at a framework that is built." />
  </Target>

  <!-- Each framework writes to its own obj directory, so parallel inner builds
       never race on one file. -->
  <Target Name="EtymonRequestSurface"
          BeforeTargets="CoreCompile"
          Condition="'$(_EtymonWritesSurface)' == 'true'">
    <PropertyGroup>
      <OtherFlags>$(OtherFlags) --sig:"$(IntermediateOutputPath)Surface.fsi"</OtherFlags>
    </PropertyGroup>
  </Target>

  <!-- A plain copy. Routing the text through items would let MSBuild on Unix
       normalise every backslash in a doc comment as if it were a path, so the
       ubuntu and macOS builds would disagree with the Windows one. The copy is
       byte-exact. The compiler writes CRLF on Windows and Linux alike (checked on
       both), and .gitattributes normalises *.fsi to LF in the repository, so
       the staleness check compares content and never line endings. -->
  <Target Name="EtymonWriteSurface"
          AfterTargets="CoreCompile"
          Condition="'$(_EtymonWritesSurface)' == 'true' AND '$(TargetFramework)' == '$(EtymonSurfaceFramework)' AND Exists('$(IntermediateOutputPath)Surface.fsi')">
    <Copy SourceFiles="$(IntermediateOutputPath)Surface.fsi"
          DestinationFiles="$(MSBuildProjectDirectory)/Surface.fsi"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
