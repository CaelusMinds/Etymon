<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsAotCompatible>false</IsAotCompatible>
    <!-- One target framework. A benchmark comparing net8.0 against net10.0 is a
         benchmark of the runtime, which is not the question being asked here. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <!-- BenchmarkDotNet needs optimisations on to mean anything, and says so
         loudly at startup if they are not. -->
    <Optimize>true</Optimize>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

</Project>
