<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Nullness on, because WireField exists for consumers who have it on. With
      it off, a getter typed 'T -> string compiles here and fails at every call
      site in the audience the module is for, which is exactly what shipped in
      preview.5.
    -->
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="SchemaTests.fs" />
    <Compile Include="WireFieldTests.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Etymon.Schema/Etymon.Schema.fsproj" />
  </ItemGroup>

</Project>
