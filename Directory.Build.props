<Project>

  <!-- ==========================================================
       Identity. Change RepositoryOwner once, here, and every
       package's metadata and SourceLink follow.
       ========================================================== -->
  <PropertyGroup>
    <RepositoryOwner>CaelusMinds</RepositoryOwner>
    <SuiteName>Etymon</SuiteName>
    <RepositoryUrl>https://github.com/$(RepositoryOwner)/$(SuiteName)</RepositoryUrl>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- ==========================================================
       Version. Lockstep across the whole suite for 0.x; every
       package ships the same number so "which versions go
       together" is never a question.
       ========================================================== -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <!--
      Everything before the first stable release is a preview. A version on
      nuget.org can never be deleted, only unlisted, and the number is burned
      either way, so 0.1.0 itself is a one-shot that should not be spent until
      the API has survived a real consumer. Previews are cheap and disposable.

      Bump the counter for each drop. A stable release clears it:
          dotnet pack -c Release -p:VersionSuffix=
    -->
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">preview.2</VersionSuffix>
  </PropertyGroup>

  <!-- ==========================================================
       Compilation
       ========================================================== -->
  <PropertyGroup>
    <!--
      Everything except the project BenchmarkDotNet generates at run time. That
      one lands under artifacts/, inherits this file, and would otherwise be
      built for net8.0 and fail to reference a net10.0-only benchmark.

      Excluded by name rather than by "does it already set TargetFramework",
      which is the obvious condition and is wrong: the artifacts layout appends
      the framework to the output folder only while TargetFrameworks is set, so
      suppressing it for inner builds puts net8.0 and net10.0 output in one
      directory and a net8.0 project then links a net10.0 assembly.
    -->
    <TargetFrameworks Condition="'$(MSBuildProjectName)' != 'BenchmarkDotNet.Autogenerated'">net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Belt and braces: these stay errors even if TreatWarningsAsErrors is
         relaxed locally. FS0025 incomplete match, FS0040 recursive-init check,
         FS0064 inferred-generic-too-broad, FS0193 internal type error. -->
    <WarningsAsErrors>$(WarningsAsErrors);FS0025;FS0040;FS0064;FS0193</WarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <!-- ==========================================================
       FSharp.Core: compile against the lowest version we ask
       consumers to take, so we cannot accidentally use an API
       that is newer than our own declared floor.
       ========================================================== -->
  <PropertyGroup>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

  <!-- ==========================================================
       Deterministic builds, SourceLink, embedded symbols
       ========================================================== -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>
    <IncludeSymbols>false</IncludeSymbols>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- ==========================================================
       Output
       ========================================================== -->
  <PropertyGroup>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
