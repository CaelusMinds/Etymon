<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A relational model derived from an Etymon schema, snapshot diffing, and SQL migration scripts for PostgreSQL and SQLite. Generates SQL text and executes nothing, so it carries no database driver. Ambiguous mappings are errors rather than guesses, and destructive changes are flagged rather than emitted silently.</Description>
    <PackageTags>$(PackageTags);migrations;sql;postgresql;sqlite;ddl</PackageTags>
    <EtymonAllowedReferences>Etymon.Core;Etymon.Schema</EtymonAllowedReferences>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="SqlModel.fs" />
    <Compile Include="Mapping.fs" />
    <Compile Include="Dialect.fs" />
    <Compile Include="Diff.fs" />
    <Compile Include="Migrations.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Etymon.Core/Etymon.Core.fsproj" />
    <ProjectReference Include="../Etymon.Schema/Etymon.Schema.fsproj" />
  </ItemGroup>

</Project>
