<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The Etymon suite: one schema definition as the source of truth for JSON codecs, validation, OpenAPI, TypeScript, configuration and database structure. This package has no code of its own; it references the parts of the suite that cost nothing but FSharp.Core. The adapters (Etymon.Api.Giraffe, Etymon.Api.AspNetCore) and the generator package (Etymon.Invariants.FsCheck) are deliberately left out, because each carries a dependency that would then be everyone's.</Description>
    <PackageTags>$(PackageTags);meta</PackageTags>

    <!--
      No assembly. A meta-package that ships an empty lib/ folder makes every
      consumer carry a file that does nothing, and NU5128 exists to complain
      about exactly that shape, so suppress it deliberately rather than
      inventing a placeholder type to keep the compiler company.
    -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsAotCompatible>false</IsAotCompatible>

    <EtymonAllowedReferences>Etymon.Core;Etymon.Base;Etymon.Schema;Etymon.Schema.OpenApi;Etymon.Schema.TypeScript;Etymon.Schema.Events;Etymon.Invariants;Etymon.Config;Etymon.Schema.Sql;Etymon.Api;Etymon.Api.Client</EtymonAllowedReferences>
  </PropertyGroup>

  <!-- The compiler needs an input even when nothing is shipped. -->
  <ItemGroup>
    <Compile Include="Empty.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Etymon.Core/Etymon.Core.fsproj" />
    <ProjectReference Include="../Etymon.Base/Etymon.Base.fsproj" />
    <ProjectReference Include="../Etymon.Schema/Etymon.Schema.fsproj" />
    <ProjectReference Include="../Etymon.Schema.OpenApi/Etymon.Schema.OpenApi.fsproj" />
    <ProjectReference Include="../Etymon.Schema.TypeScript/Etymon.Schema.TypeScript.fsproj" />
    <ProjectReference Include="../Etymon.Schema.Events/Etymon.Schema.Events.fsproj" />
    <ProjectReference Include="../Etymon.Invariants/Etymon.Invariants.fsproj" />
    <ProjectReference Include="../Etymon.Config/Etymon.Config.fsproj" />
    <ProjectReference Include="../Etymon.Schema.Sql/Etymon.Schema.Sql.fsproj" />
    <ProjectReference Include="../Etymon.Api/Etymon.Api.fsproj" />
    <ProjectReference Include="../Etymon.Api.Client/Etymon.Api.Client.fsproj" />
  </ItemGroup>

</Project>
