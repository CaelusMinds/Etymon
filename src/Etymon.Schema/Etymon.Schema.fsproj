<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A combinator-based schema type for F#: one value that describes how a type is encoded, decoded, validated and documented. JSON via System.Text.Json, decode errors that accumulate and carry field paths, and an untyped description that OpenAPI, SQL and test generators all read.</Description>
    <PackageTags>$(PackageTags);codec;serialization;system-text-json;combinators</PackageTags>
    <!-- System.Text.Json ships in the shared framework for both target
         frameworks, so it is an in-box API here rather than a dependency. -->
    <EtymonAllowedReferences>Etymon.Core</EtymonAllowedReferences>

    <!--
      Nullness is on for this package alone. WireField exists to cross records
      that arrived nullable, so its signatures have to say so. A getter typed
      'T -> string is a compile error at every call site in a consumer that has
      nullness enabled, which is precisely the audience the module is for.

      Not on suite-wide: the flow analysis that makes isNull narrow a binding
      needs FSharp.Core 9, and Etymon compiles against 8.0.100 on purpose so it
      cannot use an API newer than the floor it asks consumers to take. The
      syntax alone works at 8.0.100, which is all this package needs.
    -->
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="SchemaInfo.fs" />
    <Compile Include="Codec.fs" />
    <Compile Include="Schema.fs" />
    <Compile Include="ConstraintCodec.fs" />
    <Compile Include="WireField.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Etymon.Core/Etymon.Core.fsproj" />
  </ItemGroup>

</Project>
