<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>An F#-idiomatic layer over the most-used base-library APIs: parsing with explicit culture, string and dictionary helpers, environment variables, and file IO with a typed error union. Returns option and Result instead of null and exceptions. Depends on nothing but FSharp.Core.</Description>
    <PackageTags>$(PackageTags);prelude;parsing;io;result;option</PackageTags>
    <!-- Std is deliberately standalone: it is useful without any of the rest of
         the suite, and nothing in the suite is allowed to make it heavier. -->
    <EtymonAllowedReferences></EtymonAllowedReferences>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Parse.fs" />
    <Compile Include="Str.fs" />
    <Compile Include="Dict.fs" />
    <Compile Include="Env.fs" />
    <Compile Include="Files.fs" />
  </ItemGroup>

</Project>
